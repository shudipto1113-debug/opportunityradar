{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opportunityradar",
  "main": "wrapper.js",
  "compatibility_date": "2026-07-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "opportunityradar_events"
    }
  ],
  "observability": {
    "enabled": true
  }
}
